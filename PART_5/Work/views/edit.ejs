<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <script src="https://cdn.tailwindcss.com"></script>
    <title>Show Data</title>
  </head>
  <body class="bg-zinc-900">
    <div class="main w-full min-h-screen bg-zinc-900 p-10 text-zinc-100">
      <a href="/" class="text-blue-400 hover:underline mb-10 inline-block">
        ← Go back to Home
      </a>

      <form class="flex flex-col gap-4" action="/edit" method="post">
        <input
          type="text"
          placeholder="Previous Title"
          class="w-1/4 px-4 py-2 rounded-md bg-zinc-900 text-zinc-600 text-white border border-zinc-700 focus:outline-none focus:ring-2 focus:ring-blue-500"
          name="previous"
          value="<%=filename%>"
          disabled="true"
        />

        <input
          type="text"
          placeholder="New Title"
          class="w-1/4 px-4 py-2 rounded-md bg-zinc-900 text-white border border-zinc-700 focus:outline-none focus:ring-2 focus:ring-blue-500"
          name="New"
        />

        <button
          type="submit"
          class="bg-blue-600 w-1/4 hover:bg-yellow-700 text-white py-2 rounded-md font-medium transition"
        >
          Edit FileName
        </button>
      </form>
    </div>
  </body>
</html>
