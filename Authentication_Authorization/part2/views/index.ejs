<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Create User</title>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
  </head>
  <body>
    <div
      class="w-full h-screen bg-zinc-900 flex items-center justify-center p-10"
    >
      <form
        method="post"
        action="/create"
        class="bg-zinc-800 p-8 rounded-xl w-[350px] space-y-4 shadow-lg"
      >
        <h2 class="text-white text-2xl font-semibold text-center">
          Create User
        </h2>

        <input
          type="text"
          name="username"
          placeholder="Username"
          class="w-full px-4 py-2 rounded bg-zinc-700 text-white placeholder-zinc-400 focus:outline-none focus:ring-2 focus:ring-blue-500"
        />

        <input
          type="email"
          name="email"
          placeholder="Email"
          class="w-full px-4 py-2 rounded bg-zinc-700 text-white placeholder-zinc-400 focus:outline-none focus:ring-2 focus:ring-blue-500"
        />

        <input
          type="password"
          name="password"
          placeholder="Password"
          class="w-full px-4 py-2 rounded bg-zinc-700 text-white placeholder-zinc-400 focus:outline-none focus:ring-2 focus:ring-blue-500"
        />

        <input
          type="number"
          name="age"
          placeholder="Age"
          class="w-full px-4 py-2 rounded bg-zinc-700 text-white placeholder-zinc-400 focus:outline-none focus:ring-2 focus:ring-blue-500"
        />

        <input
          type="submit"
          value="Create User"
          class="w-full bg-blue-600 hover:bg-blue-700 text-white py-2 rounded-md font-medium cursor-pointer transition"
        />
      </form>
    </div>
  </body>
</html>
