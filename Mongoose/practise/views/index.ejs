<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Mongoo</title>
    <link rel="stylesheet" href="/stylesheets/style.css" />
    <script src="https://cdn.tailwindcss.com"></script>
  </head>
  <body>
    <div class="w-full h-full bg-zinc-900 p-10 text-white">
      <div class="nav mb-10">
        <a class="text-blue-500" href="/read">Read Users</a>
      </div>
      <h1 class="text-3xl tracking-tighter">Create User</h1>

      <form action="/create" method="post">
        <input
          type="text"
          placeholder="Name"
          class="px-5 py-2 bg-transparent border-2 border-zinc-300 rounded-md"
          name="name"
        />

        <input
          type="text"
          placeholder="Email"
          class="px-5 py-2 bg-transparent border-2 border-zinc-300 rounded-md"
          name="email"
        />

        <input
          type="text"
          placeholder="Image Url"
          class="px-5 py-2 bg-transparent border-2 border-zinc-300 rounded-md"
          name="img"
        />

        <input
          type="submit"
          value="Create User"
          class="px-5 py-2 bg-blue-600 rounded-md ml-3"
        />
      </form>
    </div>
  </body>
</html>
