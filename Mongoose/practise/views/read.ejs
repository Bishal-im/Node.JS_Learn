<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Mongoo</title>
    <link rel="stylesheet" href="/stylesheets/style.css" />
    <script src="https://cdn.tailwindcss.com"></script>
  </head>
  <body>
    <div class="w-full h-full bg-zinc-900 p-10 text-white">
      <div class="nav mb-10">
        <a class="text-red-500" href="/">Back to Home</a>
      </div>

      <h1 class="text-3xl tracking-tighter">All Users</h1>

      <div class="users flex gap-3 flex-wrap">
        <% users.forEach(function (user) { %>
          <div class="user w-72 p-4 bg-zinc-800 rounded-md overflow-hidden">
            <div class="w-full h-72 rounded-lg bg-zinc-500">
              <img class="w-full h-full object-cover object-center" src="<%= user.image %>">
            </div>

            <h3 class="text-xl mt-3 tracking-tighter"><%= user.name %></h3>
            <h5 class="text-zinc-500"><%= user.email %></h5>

            <div class="flex gap-3 mt-7">
              <a href="/edit/<%= user._id %>" class="text-zinc-600">Edit user</a>
              <a href="/delete/<%= user._id %>" class="text-red-500">Delete</a>
            </div>
          </div>
        <% }) %>
      </div>
    </div>
  </body>
</html>
